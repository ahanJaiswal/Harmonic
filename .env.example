# ── App Check debug tokens (dev only — never use in production) ───────────────
# Generate via Firebase console → App Check → Apps → Manage debug tokens
VITE_APP_CHECK_DEBUG_TOKEN=your-web-debug-token-here

# Android: set in local.properties or via CI secret:
# APP_CHECK_DEBUG_TOKEN_ANDROID=your-android-debug-token-here

# iOS: set in Xcode scheme environment variables or CI secret:
# APP_CHECK_DEBUG_TOKEN_IOS=your-ios-debug-token-here

# ── Firebase web config (safe to commit; App Check + Firestore rules protect it)
# Copy from Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Never put service-account keys here ───────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Machines ───────────────────────────────────────────────────────────
    match /machines/{machineId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;
    }

    // ── Join codes ─────────────────────────────────────────────────────────
    // Any signed-in phone can look up a code. Only the host writes it.
    match /joinCodes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    // ── Sessions ───────────────────────────────────────────────────────────
    // Lobby sessions are readable so a joiner can attach. After that, only
    // the owner and memberUids can read. A joiner may add only themselves.
    match /sessions/{sessionId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid
            || request.auth.uid in resource.data.get('memberUids', [])
            || resource.data.status == 'lobby');

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerUid
        || request.auth.uid in resource.data.get('memberUids', [])
        || (
          resource.data.status == 'lobby'
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.joinCode == resource.data.joinCode
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'members'])
        )
      );

      match /recordings/{deviceId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid
              || request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('memberUids', []));
        allow create, update: if request.auth != null
          && request.auth.uid == deviceId
          && (request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid
              || request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('memberUids', []));
      }
    }

    // ── Inference logs ─────────────────────────────────────────────────────
    // Any authenticated user can write their own logs; read own logs only.
    match /inference_logs/{logId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // ── Benchmarks ─────────────────────────────────────────────────────────
    // Public read (judges); only service account writes (via Admin SDK, not client).
    match /benchmarks/{runId} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }
  }
}

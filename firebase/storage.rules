rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Recordings ─────────────────────────────────────────────────────────
    // Only session members can read/write recordings.
    // (Session membership is checked via Firestore; simplified here — tighten post-hackathon.)
    match /recordings/{sessionId}/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // ── Spectra (PNG for Nano) ──────────────────────────────────────────────
    match /spectra/{sessionId}/{file} {
      allow read, write: if request.auth != null;
    }

    // ── Machine manuals (PDF) ──────────────────────────────────────────────
    match /manuals/{machineId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // owner only — tighten post-hackathon
    }
  }
}

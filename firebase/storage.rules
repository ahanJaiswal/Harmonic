rules_version = '2';

// Neither the Android nor the iOS app uses Cloud Storage: per-phone recordings
// live in Firestore at sessions/{id}/recordings/{uid}. Deny everything until a
// feature actually needs a bucket, then add narrowly scoped rules for it.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
